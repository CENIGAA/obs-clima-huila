{
  "name": "obs-clima-huila",
  "private": true,
  "version": "1.0.0",
  "description": "Observatorio Climatico del Huila Efrain Dominguez Calle - CENIGAA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
